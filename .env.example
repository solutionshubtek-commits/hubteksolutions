# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (GPT-4o, Whisper, text-embedding-3-small)
OPENAI_API_KEY=

# Anthropic — motor de backup para failover automático
ANTHROPIC_API_KEY=

# Evolution API — integração WhatsApp
EVOLUTION_API_URL=             # ex: https://evolution.seudominio.com
EVOLUTION_API_KEY=             # chave global da Evolution API
EVOLUTION_WEBHOOK_SECRET=      # token para validar webhooks recebidos — deve ser
                               # DIFERENTE de EVOLUTION_API_KEY: ele trafega como
                               # header em todo webhook e nao pode expor a chave global
EVOLUTION_WEBHOOK_SECRET_ANTERIOR=  # opcional, apenas durante a rotacao do segredo acima
EVOLUTION_INSTANCE_NAME=       # nome da instância padrão (deve ser igual ao slug do tenant)

# Google Calendar (opcional)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# E-mail transacional (Resend)
RESEND_API_KEY=

# Destino dos alertas de operação (instância de WhatsApp fora do ar).
# Um e-mail, ou vários separados por vírgula: ops@empresa.com,suporte@empresa.com
# Sem isto o monitor ainda corrige o status e loga a queda, mas ninguém é avisado.
ALERTA_OPERACAO_EMAIL=

# Redis (Upstash) — debounce de mensagens do agente e rate limit.
# Sem estas duas o sistema degrada em silêncio: o debounce e o rate limit
# simplesmente nao entram em acao (veja lib/ai/debounce.ts e lib/security/ratelimit.ts).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Segredo dos cron jobs e das chamadas internas entre rotas.
# Na Vercel e injetado automaticamente nas rotas de /api/cron; localmente
# precisa estar aqui, senao os crons rodam com "Bearer undefined" e recusam
# a propria chamada. NUNCA deixe em branco: string vazia faz o header
# "Bearer " (so o prefixo) virar uma autorizacao valida.
CRON_SECRET=

# ID do usuario admin da Hubtek que recebe os avisos de expiracao de cliente.
# Usado com "!" em app/api/cron/verificar-expiracao/route.ts — se faltar,
# o cron das 9h quebra.
ADMIN_HUBTEK_USER_ID=

# URL base da aplicacao, usada nas chamadas internas entre rotas.
# Sem ela o codigo cai no fallback de producao — ou seja, rodando local
# essas chamadas batem no servidor de producao em vez do localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Next.js
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
